{
  "name": "certitrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CertiTrack: one portal for every government certificate, tracked live from application to doorstep. Frontend prototype.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
